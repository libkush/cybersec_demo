#!/bin/bash
# =============================================================================
#  ATTACKER node bootstrap
#    - node_exporter (so we can graph the flood from the attacker side)
#    - the attack tooling in /opt/lab/attack
#    - /etc/lab/attack.env with the target and socket counts
#    - a lab-slowloris.service unit that is installed but NOT enabled
#
#  Nothing here fires on its own. The attack only starts when the operator runs
#  ./scripts/attack.sh start, which SSHes in and starts the unit.
#
#  Log: /var/log/lab-init.log
# =============================================================================
set -euo pipefail

exec > >(tee /var/log/lab-init.log | logger -t lab-init -s 2>/dev/console) 2>&1

ASSET_BUCKET="${asset_bucket}"
ASSET_PREFIX="${asset_prefix}"
REGION="${region}"
LAB_NAME="${lab_name}"
NODE_EXPORTER_VERSION="${node_exporter_version}"

ATTACK_TARGET="${attack_target}"
ATTACK_PORT="${attack_port}"
ATTACK_SOCKETS="${attack_sockets}"
ATTACK_INTERVAL="${attack_interval}"
ATTACK_TIMEOUT="${attack_timeout}"

log() { echo "[lab-init] $*"; }

fetch_asset() {
  local key="$1" dest="$2" attempt
  mkdir -p "$(dirname "$dest")"
  for attempt in 1 2 3 4 5; do
    if aws s3 cp "s3://$ASSET_BUCKET/$ASSET_PREFIX/$key" "$dest" \
         --region "$REGION" --only-show-errors; then
      return 0
    fi
    log "retry $attempt fetching $key"
    sleep $((attempt * 3))
  done
  log "FATAL: could not fetch s3://$ASSET_BUCKET/$ASSET_PREFIX/$key"
  return 1
}

install_exporter() {
  # install_exporter <owner/repo> <binary-name> <version>
  local slug="$1" name="$2" version="$3" attempt
  local tarball="$name-$version.linux-amd64.tar.gz"

  if [ "$${slug#*/}" = "$slug" ]; then
    log "FATAL: install_exporter needs an owner/repo slug, got '$slug'"
    return 1
  fi

  local url="https://github.com/$slug/releases/download/v$version/$tarball"
  for attempt in 1 2 3 4 5; do
    if curl -fsSL --connect-timeout 10 --retry 3 -o "/tmp/$tarball" "$url"; then
      tar -xzf "/tmp/$tarball" -C /tmp
      install -m 0755 "/tmp/$name-$version.linux-amd64/$name" "/usr/local/bin/$name"
      return 0
    fi
    log "retry $attempt downloading $url"
    sleep $((attempt * 3))
  done
  log "FATAL: could not download $url"
  return 1
}

ensure_user() {
  getent passwd "$1" >/dev/null 2>&1 || \
    useradd --system --no-create-home --shell /usr/sbin/nologin "$1"
}

# AL2023 ships AWS CLI v2, but do not bet the whole demo on it.
ensure_aws_cli() {
  if command -v aws >/dev/null 2>&1; then
    return 0
  fi
  log "AWS CLI missing -- installing"
  dnf -y install awscli-2 || dnf -y install awscli || \
    die_loud "could not install the AWS CLI"
}

die_loud() { log "FATAL: $*"; exit 1; }

log "installing packages"
dnf -y install jq

# -----------------------------------------------------------------------------
#  node_exporter
# -----------------------------------------------------------------------------
install_exporter prometheus/node_exporter node_exporter "$NODE_EXPORTER_VERSION"
ensure_user node_exporter
fetch_asset "systemd/node_exporter.service" /etc/systemd/system/node_exporter.service

# -----------------------------------------------------------------------------
#  Attack tooling
# -----------------------------------------------------------------------------
log "installing attack scripts"
install -d -m 0755 /opt/lab/attack
fetch_asset "attack/slowloris.py"  /opt/lab/attack/slowloris.py
fetch_asset "attack/http_flood.py" /opt/lab/attack/http_flood.py
chmod 0755 /opt/lab/attack/slowloris.py /opt/lab/attack/http_flood.py

# -----------------------------------------------------------------------------
#  Attack parameters, consumed by lab-slowloris.service via EnvironmentFile
# -----------------------------------------------------------------------------
log "writing /etc/lab/attack.env"
install -d -m 0755 /etc/lab
cat > /etc/lab/attack.env <<ENVFILE
# Generated by OpenTofu. Edit on the node, or change the variables and re-apply.
TARGET=$ATTACK_TARGET
PORT=$ATTACK_PORT
SOCKETS=$ATTACK_SOCKETS
INTERVAL=$ATTACK_INTERVAL
TIMEOUT=$ATTACK_TIMEOUT
ENVFILE
chmod 0644 /etc/lab/attack.env

fetch_asset "systemd/lab-slowloris.service" /etc/systemd/system/lab-slowloris.service

systemctl daemon-reload
systemctl enable --now node_exporter

# Installed but deliberately NOT enabled: the attack waits for a human.
systemctl disable lab-slowloris >/dev/null 2>&1 || true

log "attacker bootstrap complete -- target $ATTACK_TARGET:$ATTACK_PORT, $ATTACK_SOCKETS sockets (idle until started)"
